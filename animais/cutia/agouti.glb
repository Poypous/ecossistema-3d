/* ============================================================
   Cutia: tudo sobre este animal fica nesta pasta.
   Seções: 1) dados e card · 2) ícone · 3) modelo 3D · 4) comportamento

   Modelo 3D realista: "Cutia (Dasyprocta)"
   por Do real ao digital (https://sketchfab.com/Dayanecs), licença CC-BY-4.0
   https://sketchfab.com/3d-models/cutia-dasyprocta-fca07562e7f246bebcee940653faf853
   (malha reduzida de ~33 mil para ~12 mil triângulos e textura comprimida)
   ============================================================ */

/* --- Dados do modelo 3D embutidos (NÃO EDITAR; sem arquivos externos, funciona abrindo direto o index.html) --- */
const CUTIA_MESH = {"n":7947,"pos":"","nrm":"","uv":"","idx":"","minY":0.24631217807769637,"maxY":0.5246756034046257,"tex":"data:image/jpeg;base64,"};

registerAnimal('cutia', {

  /* 1) DADOS: card informativo, quantidade inicial/máxima, cor do destaque e área de clique */
  data: {
      name: "Cutia",
      sci: "Dasyprocta azarae",
      diet: "Herbívoro (frugívoro)",
      role: "Dispersora de sementes",
      habitat: "Chão da floresta, perto de árvores frutíferas.",
      desc: "Roedor que procura alimento no chão da mata. Enterra sementes e esquece parte delas, ajudando a floresta a se regenerar.",
      fact: "É uma das principais responsáveis por espalhar o pinhão da araucária.",
      qty: 7,
      max: 30,
      color: "#26c6da",
      hit: 0.65,
      hy: 0.4,
      top: 0.9,
      kind: "land"
  },

  /* 2) ÍCONE (legenda e card) */
  icon: `<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="11" cy="16" r="5" fill="#6b4423"/><circle cx="37" cy="16" r="5" fill="#6b4423"/><ellipse cx="24" cy="28" rx="16" ry="14" fill="#8a5a2b"/><path d="M12 22c4-6 20-6 24 0-4-2-20-2-24 0z" fill="#c98c3a"/><ellipse cx="24" cy="36" rx="8" ry="5.5" fill="#e0c9a0"/><circle cx="17" cy="27" r="2" fill="#1b1b1b"/><circle cx="31" cy="27" r="2" fill="#1b1b1b"/><ellipse cx="24" cy="33" rx="2.4" ry="1.7" fill="#1b1b1b"/></svg>`,

  /* 3) MODELO 3D: corpo realista (malha + textura de pelo) sobre as pernas.
        - Pernas: usa as do sistema (que ele já anima). Se não encontrar, cria pernas próprias
          que balançam conforme a distância percorrida.
        - Cabeça baixa ao pastar/beber: acompanha o movimento da cabeça do sistema (invisível). */
  build(sp) {
    // o sistema monta o animal procedural: mantemos o grupo (e seus dados internos), só trocamos o visual
    const g = Kit.land({ body: [.5, .27, .22], lh: .26, neck: .06, head: [.19, .16, .13], snout: .09,
      ear: [.04, .06], tail: [.05, .05], legs: .05, c: [0x8a5a2b, 0xe0c9a0, 0x4a2f15] }, sp);
    const u = sp.top, lh = .26 * u, ud = g.userData || {};

    // pernas do sistema continuam visíveis; todo o resto do corpo procedural fica oculto
    const keep = new Set();
    const legs = Array.isArray(ud.legs) ? ud.legs : null;
    if (legs) legs.forEach(l => { const o = Array.isArray(l) ? l[0] : l; if (o && o.traverse) o.traverse(x => keep.add(x)); });
    g.traverse(o => { if (o.isMesh && !keep.has(o)) o.visible = false; });

    const sh = cutiaShared();
    const s = 1.35 * u;                                              // comprimento focinho-cauda
    const tilt = new THREE.Group(); tilt.position.set(-.3 * s, 0, 0); g.add(tilt);   // eixo da "cabeça baixa": quadril
    const mesh = new THREE.Mesh(sh.geo, sh.mat);
    mesh.scale.setScalar(s); mesh.castShadow = true;
    mesh.position.set(.3 * s - .1 * s, lh - .03 * u - CUTIA_MESH.minY * s, 0);   // barriga logo acima das pernas
    tilt.add(mesh);

    // pernas próprias (só se o sistema não forneceu as dele)
    const own = [];
    if (!legs) {
      const lm = new THREE.MeshStandardMaterial({ color: 0x4a2f15, roughness: 1 }), L = lh + .05 * u;
      [[.26, 1], [.26, -1], [-.12, 1], [-.12, -1]].forEach(([x, z], i) => {
        const pv = new THREE.Group(); pv.position.set(x * s, lh + .02 * u, z * .09 * s);
        const m = new THREE.Mesh(new THREE.CylinderGeometry(.045 * u, .03 * u, L, 6), lm); m.position.y = -L / 2; m.castShadow = true;
        pv.add(m); g.add(pv); own.push([pv, (x > 0) === (z > 0) ? 0 : Math.PI]);
      });
    }

    // animação: pernas próprias por distância andada; cabeça baixa pelo sinal da cabeça do sistema
    const st = { last: new THREE.Vector3(), has: false, t: 0, phase: 0, amp: 0, base: Infinity, pitch: 0 }, tmp = new THREE.Vector3();
    mesh.onBeforeRender = () => {
      const now = performance.now() / 1000, dt = st.t ? now - st.t : 0; st.t = now;
      mesh.getWorldPosition(tmp);
      if (st.has && dt > 0 && dt < .2) {
        const dist = Math.hypot(tmp.x - st.last.x, tmp.z - st.last.z);
        st.amp += (Math.min(1, dist / dt / 1.0) - st.amp) * .2;
        st.phase += dist * 2 * Math.PI / u;
        own.forEach(([pv, off]) => { pv.rotation.z = Math.sin(st.phase + off) * .7 * st.amp; });
      }
      st.last.copy(tmp); st.has = true;
      const h = ud.head;
      if (h && h.rotation) {
        const v = Math.abs(Math.abs(h.rotation.x) > Math.abs(h.rotation.z) ? h.rotation.x : h.rotation.z);
        st.base = Math.min(st.base, v);
        const target = Math.min(.45, (v - st.base) * .6);
        st.pitch += (target - st.pitch) * .2;
        tilt.rotation.z = -st.pitch;                                  // focinho para baixo
      }
    };
    return g;
  },

  /* 4) COMPORTAMENTO: pasta, bebe água na lagoa ou caminha. Não foge de ninguém. */
  decide(a, H) {
    const p = Math.random();
    if (p < .5) return H.st(a, 'graze', H.r(5, 10));
    if (p < .68) return H.go(a, H.pondPt(), 'drink', H.r(3, 6));
    H.go(a, H.landPoint(), 'idle', H.r(1, 2));
  }
});

/* Geometria e material compartilhados por todas as cutias (criados uma única vez). */
let _cutiaShared = null;
function cutiaShared() {
  if (_cutiaShared) return _cutiaShared;
  const D = CUTIA_MESH, n = D.n;
  const bytes = b64 => { const s = atob(b64), a = new Uint8Array(s.length); for (let i = 0; i < s.length; i++) a[i] = s.charCodeAt(i); return a; };
  const i16 = new Int16Array(bytes(D.pos).buffer), i8 = new Int8Array(bytes(D.nrm).buffer),
        u16 = new Uint16Array(bytes(D.uv).buffer), idx = new Uint16Array(bytes(D.idx).buffer);
  const pos = new Float32Array(n * 3), nrm = new Float32Array(n * 3), uv = new Float32Array(n * 2);
  for (let i = 0; i < n * 3; i++) { pos[i] = i16[i] / 32000; nrm[i] = i8[i] / 127; }
  for (let i = 0; i < n * 2; i++) uv[i] = u16[i] / 65535;
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  geo.setAttribute('normal', new THREE.BufferAttribute(nrm, 3));
  geo.setAttribute('uv', new THREE.BufferAttribute(uv, 2));
  geo.setIndex(new THREE.BufferAttribute(idx, 1));
  geo.computeBoundingSphere();
  const tex = new THREE.TextureLoader().load(D.tex);
  tex.encoding = THREE.sRGBEncoding; tex.anisotropy = 4;
  const mat = new THREE.MeshStandardMaterial({ map: tex, roughness: 1, metalness: 0, side: THREE.DoubleSide });
  return (_cutiaShared = { geo, mat });
}
