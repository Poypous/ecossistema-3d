/* ============================================================
   Modelo 3D realista do bugio (GLB embutido em base64: nada para hospedar).
   Precisa só do THREE.GLTFLoader carregado (o modelo não tem esqueleto, então não usa SkeletonUtils).
   Se não existir, o bugio continua com o modelo antigo (Kit.land).
   Crédito do modelo (Sketchfab): "Monkey animal 3d model free" por iRahulRajput, licença CC BY 4.0
   ============================================================ */
const BugioGLB = (() => {
  const B64 = '';
  const ESCALA = 1;            // altura do modelo = ESCALA × 'top' do bugio. Ajuste aqui.
  const ALTURA_MODELO = 1.9;   // altura original do GLB (não mexa)
  const OFFSET = { y: .951, z: 0 };   // apoia os pés na base do animal (unidades do GLB)

  let gltf = null, carregando = false;
  const fila = [], vivos = []; let P = null;   // P é criado só quando o THREE existir

  const bytes = () => { const s = atob(B64), u = new Uint8Array(s.length); for (let i = 0; i < s.length; i++) u[i] = s.charCodeAt(i); return u.buffer; };
  const falha = e => console.warn('Bugio (GLB):', e);

  // Lê o arquivo uma vez e clona a cena para cada bugio (a malha e a textura são compartilhadas).
  function obter(cb) {
    const pronto = g => cb(g.scene.clone(true));
    if (gltf) return pronto(gltf);
    fila.push(pronto);
    if (carregando) return;
    carregando = true;
    new THREE.GLTFLoader().parse(bytes(), '', g => { gltf = g; fila.splice(0).forEach(f => f(g)); }, falha);
  }

  // Sem esqueleto: nos saltos o corpo se inclina para a frente e balança; parado, só oscila de leve.
  let rodando = false, t0 = 0;
  function ciclo() {
    if (rodando) return; rodando = true; t0 = performance.now(); P = new THREE.Vector3();
    const passo = () => {
      requestAnimationFrame(passo);
      const t = performance.now(), dt = Math.min((t - t0) / 1000, .1); t0 = t;
      for (const v of vivos) {
        v.base.getWorldPosition(P);
        const vel = v.ini ? P.distanceTo(v.ult) / Math.max(dt, 1e-3) : 0;
        v.ult.copy(P); v.ini = true; v.vel = v.vel * .85 + vel * .15; v.fase += dt;
        const pulando = v.vel > .15 * v.top;
        v.incl += ((pulando ? .35 : 0) - v.incl) * Math.min(1, dt * 6);
        v.pivo.rotation.x = v.incl + (pulando ? 0 : Math.sin(v.fase * 1.3) * .015);
        v.pivo.rotation.z = Math.sin(v.fase * (pulando ? 6 : 1.5)) * (pulando ? .06 : .03);
      }
    };
    passo();
  }

  function anexar(base, sp) {
    obter(modelo => {
      base.traverse(o => { if (o.isMesh) o.visible = false; });   // esconde o modelo antigo
      const top = (sp && sp.top) || 1.5, pivo = new THREE.Group();
      modelo.position.set(0, OFFSET.y, OFFSET.z);
      pivo.add(modelo); pivo.scale.setScalar(ESCALA * top / ALTURA_MODELO); base.add(pivo);
      modelo.traverse(o => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; } });
      vivos.push({ base, pivo, top, ult: new THREE.Vector3(), ini: false, vel: 0, incl: 0, fase: Math.random() * 6 });
      ciclo();
    });
  }
  return { anexar };
})();

/* ============================================================
   Bugio: tudo sobre este animal fica nesta pasta.
   Seções: 1) dados e card · 2) ícone · 3) modelo 3D · 4) comportamento
   ============================================================ */
registerAnimal('bugio', {

  /* 1) DADOS: card informativo, quantidade inicial/máxima, cor do destaque e área de clique */
  data: {
      name: "Bugio",
      sci: "Alouatta guariba",
      diet: "Folívoro e frugívoro",
      role: "Primata arborícola",
      habitat: "Copas das árvores altas da Mata Atlântica.",
      desc: "Primata que passa quase todo o tempo nas copas, comendo folhas e frutos e saltando entre as árvores.",
      fact: "O rugido grave dos machos pode ser ouvido a grandes distâncias dentro da mata.",
      qty: 6,
      max: 20,
      color: "#d4e157",
      hit: 0.9,
      hy: 0.6,
      top: 1.5,
      kind: "tree"
  },

  /* 2) ÍCONE (legenda e card) */
  icon: `<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="8" cy="26" r="5" fill="#b4440f"/><circle cx="40" cy="26" r="5" fill="#b4440f"/><circle cx="24" cy="24" r="17" fill="#d35400"/><ellipse cx="24" cy="27" rx="11" ry="10" fill="#f0c8a0"/><circle cx="19" cy="24" r="2" fill="#222"/><circle cx="29" cy="24" r="2" fill="#222"/><ellipse cx="24" cy="30" rx="3" ry="2" fill="#a0693a"/><path d="M19 35c3 2 7 2 10 0" stroke="#7a3d12" stroke-width="2" fill="none" stroke-linecap="round"/><path d="M14 38c2 8 18 8 20 0-4 4-16 4-20 0z" fill="#9c3d08"/></svg>`,

  /* 3) MODELO 3D: bugio realista (GLB) sobre o rig do Kit.land, que continua cuidando de estados e movimento */
  build(sp) {
    const base = Kit.land({ body: [.32, .3, .2], lh: .38, neck: .12, head: [.17, .17, .15], snout: .05,
      ear: [.04, .05], tail: [.8, .045], legs: .05, beard: 1, tailA: 1, c: [0xa8420e, 0x6b2f0b, 0x3a1a08] }, sp);
    if (window.THREE && THREE.GLTFLoader) BugioGLB.anexar(base, sp);   // sem GLTFLoader: mantém o modelo antigo
    return base;
  },

  /* 4) COMPORTAMENTO: fica na copa mastigando e pula de árvore em árvore. */
  decide() {},
  init(a, H) { a.tree = H.rt(); a.g.position.copy(H.treePos(a.tree)); a.state = 'sit'; a.timer = H.r(2, 8); },
  update(a, dt, H) {
    const u = a.u, g = a.g;
    if (a.state === 'hop') {
      a.k = Math.min(1, a.k + dt / 3);
      g.position.lerpVectors(a.from, a.to, a.k); g.position.y += Math.sin(a.k * Math.PI) * 2;
      H.face(a, a.to.x - a.from.x, a.to.z - a.from.z, dt);
      if (a.k >= 1) H.st(a, 'sit', H.r(5, 10));
    } else {
      u.head.rotation.z = Math.sin(a.t * 3) * .12 - .15;
      if ((a.timer -= dt) < 0) { const n = H.rt(); a.from = g.position.clone(); a.to = H.treePos(n); a.k = 0; a.state = 'hop'; }
    }
    H.lerp(a, 'mv', a.state === 'hop' ? 1 : 0, dt, 5);
    u.legs.forEach((l, i) => { l.rotation.z = Math.sin(a.t * 8 + (i % 3 ? Math.PI : 0)) * .7 * a.mv; });
  }
});
